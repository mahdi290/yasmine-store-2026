{
  "name": "frontend",
  "version": "0.0.0",
  "scripts": {
    "postinstall": "node -e \"const fs=require('fs');const p='./node_modules/@angular/cli/src/utilities/node-version.js';if(fs.existsSync(p)){let c=fs.readFileSync(p,'utf8');c=c.replace('\\^22.22.3','\\^22.11.0');fs.writeFileSync(p,c);}\"",
    "ng": "node ./run-ng.js",
    "start": "node ./run-ng.js serve",
    "build": "node ./run-ng.js build",
    "watch": "node ./run-ng.js build --watch --configuration development",
    "test": "node ./run-ng.js test --watch=false",
    "serve:ssr:frontend": "node dist/frontend/server/server.mjs"
  },
  "private": true,
  "packageManager": "npm@11.13.0",
  "dependencies": {
    "@angular/common": "^22.0.0",
    "@angular/compiler": "^22.0.0",
    "@angular/core": "^22.0.0",
    "@angular/forms": "^22.0.0",
    "@angular/platform-browser": "^22.0.0",
    "@angular/platform-server": "^22.0.0",
    "@angular/router": "^22.0.0",
    "@angular/ssr": "^22.0.0",
    "bootstrap": "^5.3.8",
    "bootstrap-icons": "^1.13.1",
    "express": "^5.1.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.0.0",
    "@angular/cli": "^22.0.0",
    "@angular/compiler-cli": "^22.0.0",
    "@types/express": "^5.0.1",
    "@types/node": "^20.17.19",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "vitest": "^4.0.8"
  }
}
